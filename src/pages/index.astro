---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Calma en 3 Minutos",
  "description": "Ejercicios de respiración para calmar la ansiedad en 3 minutos.",
  "url": "https://calmaen3minutos.com",
  "applicationCategory": "HealthApplication"
};
---

<BaseLayout 
  title="Calma tu Ansiedad en 3 Minutos | Ejercicios de Respiración"
  description="Ejercicios de respiración para crisis de ansiedad. 4-7-8, box breathing, diafragmática. Gratis."
  canonical="https://calmaen3minutos.com/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex flex-col items-center justify-center px-4 select-none">
    
    <!-- Home -->
    <div id="home-screen" class="flex flex-col items-center justify-center">
      <div class="mb-8 opacity-60">
        <img src="/icons/lungs.svg" alt="" class="w-12 h-12 text-teal-400" />
      </div>
      <h1 class="text-4xl md:text-6xl font-bold text-white text-center mb-4">Calma Ahora</h1>
      <p class="text-lg text-slate-400 text-center mb-10 max-w-sm">Tómate un respiro.</p>
      <button id="start-btn" class="relative w-44 h-44 md:w-56 md:h-56 rounded-full bg-gradient-to-br from-teal-400 to-cyan-500 shadow-2xl shadow-teal-500/40 active:scale-95 transition-transform duration-150 focus:outline-none focus:ring-4 focus:ring-teal-400/50" aria-label="Empezar ejercicio de respiración">
        <div class="absolute inset-0 rounded-full border-2 border-teal-400/20 animate-pulse pointer-events-none"></div>
        <div class="absolute inset-[-8px] rounded-full border border-teal-400/10 animate-pulse pointer-events-none" style="animation-delay: 0.5s"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <img src="/icons/play.svg" alt="" class="w-14 h-14 md:w-16 md:h-16 text-white ml-1" />
        </div>
      </button>
      <p class="mt-8 text-slate-600 text-xs tracking-wider uppercase">Toca para empezar</p>
    </div>

    <!-- Ejercicio -->
    <div id="exercise-screen" class="hidden flex-col items-center justify-center w-full max-w-sm mx-auto">
      <p id="technique-name" class="text-sm text-slate-500 uppercase tracking-widest mb-6">4-7-8</p>

      <!-- Circulo de progreso por CICLO -->
      <div class="relative w-64 h-64 md:w-72 md:h-72 mb-8">
        <svg class="w-full h-full -rotate-90" viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="90" fill="none" stroke="rgba(45,212,191,0.08)" stroke-width="6" />
          <circle 
            id="progress-ring" 
            cx="100" cy="100" r="90" 
            fill="none" 
            stroke="#2dd4bf" 
            stroke-width="6"
            stroke-linecap="round"
            stroke-dasharray="565.48"
            stroke-dashoffset="565.48"
            style="transition: stroke-dashoffset 0.1s linear, stroke 0.5s ease"
          />
        </svg>
        
        <!-- Orbe que respira -->
        <div class="absolute inset-6 rounded-full bg-teal-400/10 border border-teal-400/20 flex items-center justify-center overflow-hidden">
          <div id="breath-orb" class="w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-br from-teal-400/30 to-cyan-500/30 flex items-center justify-center" style="transition: transform 4s ease-in-out, background 0.5s ease">
            <span id="seconds-display" class="text-4xl md:text-5xl font-bold text-white">4</span>
          </div>
        </div>
      </div>

      <!-- Fase -->
      <p id="phase-text" class="text-2xl md:text-3xl font-semibold text-white mb-2 h-10">Inhala</p>
      <p id="phase-subtext" class="text-sm text-slate-500 mb-6">por la nariz</p>

      <!-- Timer total -->
      <div class="flex items-center gap-2 text-slate-500 mb-8">
        <img src="/icons/clock.svg" alt="" class="w-4 h-4" />
        <span id="total-timer" class="text-sm font-mono">3:00</span>
      </div>

      <!-- Controles -->
      <div class="flex gap-3">
        <button id="pause-btn" class="w-14 h-14 rounded-full bg-slate-800 hover:bg-slate-700 flex items-center justify-center transition-colors border border-slate-700" aria-label="Pausar">
          <img src="/icons/pause.svg" alt="" class="w-5 h-5 text-white" />
        </button>
        <button id="stop-btn" class="w-14 h-14 rounded-full bg-slate-800 hover:bg-slate-700 flex items-center justify-center transition-colors border border-slate-700" aria-label="Detener">
          <img src="/icons/x.svg" alt="" class="w-5 h-5 text-white" />
        </button>
      </div>
    </div>
  </main>

  <script>
    const TECHNIQUES = {
      '4-7-8': { inhale: 4, hold: 7, exhale: 8, holdEmpty: 0, name: '4-7-8' },
      'box': { inhale: 4, hold: 4, exhale: 4, holdEmpty: 4, name: 'Box Breathing' },
      'diafragmatica': { inhale: 4, hold: 0, exhale: 6, holdEmpty: 0, name: 'Diafragmatica' },
      'nasal': { inhale: 4, hold: 2, exhale: 4, holdEmpty: 0, name: 'Nasal Alternante' }
    };

    const CONFIG = TECHNIQUES['4-7-8'];
    const CYCLE_DURATION = CONFIG.inhale + CONFIG.hold + CONFIG.exhale + (CONFIG.holdEmpty || 0);
    const TOTAL_DURATION = 180;
    const CIRCUMFERENCE = 2 * Math.PI * 90;

    // Colores en armonia por fase (paleta calmante)
    const COLORS = {
      inhale: '#2dd4bf',    // Teal suave
      hold: '#a5b4fc',      // Indigo suave
      exhale: '#67e8f9',    // Cyan claro
      holdEmpty: '#c4b5fd', // Violeta suave
      complete: '#86efac'   // Verde suave
    };

    const homeScreen = document.getElementById('home-screen');
    const exerciseScreen = document.getElementById('exercise-screen');
    const startBtn = document.getElementById('start-btn');
    const pauseBtn = document.getElementById('pause-btn');
    const stopBtn = document.getElementById('stop-btn');
    const breathOrb = document.getElementById('breath-orb');
    const progressRing = document.getElementById('progress-ring');
    const secondsDisplay = document.getElementById('seconds-display');
    const phaseText = document.getElementById('phase-text');
    const phaseSubtext = document.getElementById('phase-subtext');
    const totalTimer = document.getElementById('total-timer');
    const techniqueName = document.getElementById('technique-name');

    let isPlaying = false;
    let isPaused = false;
    let secondsRemaining = TOTAL_DURATION;
    let cycleSeconds = 0;
    let totalTimerInterval = null;
    let phaseTimeout = null;
    let cycleAnimationFrame = null;

    function formatTime(s) {
      return Math.floor(s/60) + ':' + (s%60).toString().padStart(2,'0');
    }

    // Actualizar barra de progreso por CICLO (continuo)
    function updateCycleProgress() {
      if (!isPlaying || isPaused) return;
      cycleSeconds += 0.05; // Incremento cada 50ms
      if (cycleSeconds > CYCLE_DURATION) cycleSeconds = 0;
      const progress = cycleSeconds / CYCLE_DURATION;
      const offset = CIRCUMFERENCE * (1 - progress);
      progressRing.style.strokeDashoffset = offset;
      cycleAnimationFrame = requestAnimationFrame(() => setTimeout(updateCycleProgress, 50));
    }

    function setPhase(phase, duration) {
      const labels = {
        'inhale': { main: 'Inhala', sub: 'por la nariz', color: COLORS.inhale },
        'hold': { main: 'Sostén', sub: 'mantén', color: COLORS.hold },
        'exhale': { main: 'Exhala', sub: 'lentamente', color: COLORS.exhale },
        'holdEmpty': { main: 'Vacío', sub: 'respira', color: COLORS.holdEmpty }
      };
      
      const label = labels[phase];
      phaseText.textContent = label.main;
      phaseSubtext.textContent = label.sub;
      progressRing.style.stroke = label.color;
      
      // Animar orbe
      if (phase === 'inhale') {
        breathOrb.style.transform = 'scale(1.4)';
        breathOrb.style.transitionDuration = duration + 's';
        breathOrb.style.background = 'linear-gradient(135deg, rgba(45,212,191,0.4), rgba(6,182,212,0.4))';
      } else if (phase === 'exhale') {
        breathOrb.style.transform = 'scale(1)';
        breathOrb.style.transitionDuration = duration + 's';
        breathOrb.style.background = 'linear-gradient(135deg, rgba(103,232,249,0.3), rgba(167,243,208,0.3))';
      }
      
      // Countdown
      let count = duration;
      secondsDisplay.textContent = count;
      const countInterval = setInterval(() => {
        if (!isPlaying || isPaused) { clearInterval(countInterval); return; }
        count--;
        if (count >= 0) secondsDisplay.textContent = count;
      }, 1000);
      
      return duration * 1000;
    }

    function runCycle() {
      if (!isPlaying || secondsRemaining <= 0) return;
      cycleSeconds = 0;
      
      let dur = setPhase('inhale', CONFIG.inhale);
      phaseTimeout = setTimeout(() => {
        if (!isPlaying || secondsRemaining <= 0) return;
        if (CONFIG.hold > 0) {
          dur = setPhase('hold', CONFIG.hold);
          phaseTimeout = setTimeout(() => {
            if (!isPlaying || secondsRemaining <= 0) return;
            runExhale();
          }, dur);
        } else {
          runExhale();
        }
      }, dur);
    }

    function runExhale() {
      if (!isPlaying || secondsRemaining <= 0) return;
      let dur = setPhase('exhale', CONFIG.exhale);
      phaseTimeout = setTimeout(() => {
        if (!isPlaying || secondsRemaining <= 0) return;
        if (CONFIG.holdEmpty > 0) {
          dur = setPhase('holdEmpty', CONFIG.holdEmpty);
          phaseTimeout = setTimeout(() => {
            if (isPlaying && secondsRemaining > 0) runCycle();
          }, dur);
        } else if (isPlaying && secondsRemaining > 0) {
          runCycle();
        }
      }, dur);
    }

    function startExercise() {
      homeScreen.classList.add('hidden');
      exerciseScreen.classList.remove('hidden');
      exerciseScreen.classList.add('flex');
      
      isPlaying = true;
      isPaused = false;
      secondsRemaining = TOTAL_DURATION;
      cycleSeconds = 0;
      techniqueName.textContent = CONFIG.name;
      
      progressRing.style.strokeDashoffset = CIRCUMFERENCE;
      breathOrb.style.transform = 'scale(1)';
      totalTimer.textContent = formatTime(secondsRemaining);
      
      totalTimerInterval = setInterval(() => {
        if (isPlaying && !isPaused) {
          secondsRemaining--;
          totalTimer.textContent = formatTime(secondsRemaining);
          if (secondsRemaining <= 0) completeExercise();
        }
      }, 1000);
      
      updateCycleProgress();
      runCycle();
    }

    function pauseExercise() {
      if (isPaused) {
        isPaused = false;
        pauseBtn.querySelector('img').src = '/icons/pause.svg';
        updateCycleProgress();
        runCycle();
      } else {
        isPaused = true;
        pauseBtn.querySelector('img').src = '/icons/play.svg';
        clearTimeout(phaseTimeout);
        cancelAnimationFrame(cycleAnimationFrame);
        phaseText.textContent = 'Pausado';
        phaseSubtext.textContent = 'toca para continuar';
      }
    }

    function stopExercise() {
      isPlaying = false;
      isPaused = false;
      clearInterval(totalTimerInterval);
      clearTimeout(phaseTimeout);
      cancelAnimationFrame(cycleAnimationFrame);
      
      breathOrb.style.transform = 'scale(1)';
      breathOrb.style.transitionDuration = '0.5s';
      breathOrb.style.background = 'linear-gradient(135deg, rgba(45,212,191,0.3), rgba(6,182,212,0.3))';
      progressRing.style.strokeDashoffset = CIRCUMFERENCE;
      progressRing.style.stroke = COLORS.inhale;
      secondsDisplay.textContent = CONFIG.inhale;
      phaseText.textContent = 'Inhala';
      phaseSubtext.textContent = 'por la nariz';
      totalTimer.textContent = formatTime(TOTAL_DURATION);
      secondsRemaining = TOTAL_DURATION;
      cycleSeconds = 0;
      
      exerciseScreen.classList.add('hidden');
      exerciseScreen.classList.remove('flex');
      homeScreen.classList.remove('hidden');
      homeScreen.classList.add('flex');
    }

    function completeExercise() {
      isPlaying = false;
      clearInterval(totalTimerInterval);
      clearTimeout(phaseTimeout);
      cancelAnimationFrame(cycleAnimationFrame);
      
      phaseText.textContent = 'Completado';
      phaseSubtext.textContent = 'bien hecho';
      secondsDisplay.textContent = '';
      breathOrb.style.transform = 'scale(1)';
      breathOrb.style.background = 'linear-gradient(135deg, rgba(134,239,172,0.5), rgba(74,222,128,0.5))';
      progressRing.style.stroke = COLORS.complete;
      progressRing.style.strokeDashoffset = '0';
      
      setTimeout(stopExercise, 3000);
    }

    startBtn.addEventListener('click', startExercise);
    pauseBtn.addEventListener('click', pauseExercise);
    stopBtn.addEventListener('click', stopExercise);
  </script>
</BaseLayout>
