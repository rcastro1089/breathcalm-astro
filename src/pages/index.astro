---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Calma en 3 Minutos",
  "description": "Ejercicios de respiración para calmar la ansiedad en 3 minutos.",
  "url": "https://calmaen3minutos.com",
  "applicationCategory": "HealthApplication"
};
---

<BaseLayout 
  title="Calma tu Ansiedad en 3 Minutos | Ejercicios de Respiración"
  description="Ejercicios de respiración para crisis de ansiedad. 4-7-8, box breathing, diafragmática. Gratis."
  canonical="https://calmaen3minutos.com/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex flex-col items-center justify-center px-4 select-none">
    
    <!-- Home -->
    <div id="home-screen" class="flex flex-col items-center justify-center">
      <div class="mb-8 opacity-60">
        <img src="/icons/lungs.svg" alt="" class="w-12 h-12 text-teal-400" />
      </div>
      <h1 class="text-4xl md:text-6xl font-bold text-white text-center mb-4">Calma Ahora</h1>
      <p class="text-lg text-slate-400 text-center mb-10 max-w-sm">Tómate un respiro.</p>
      <button id="start-btn" class="relative w-44 h-44 md:w-56 md:h-56 rounded-full bg-gradient-to-br from-teal-400 to-cyan-500 shadow-2xl shadow-teal-500/40 active:scale-95 transition-transform duration-150 focus:outline-none focus:ring-4 focus:ring-teal-400/50" aria-label="Empezar">
        <div class="absolute inset-0 rounded-full border-2 border-teal-400/20 animate-pulse pointer-events-none"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <img src="/icons/play.svg" alt="" class="w-14 h-14 md:w-16 md:h-16 text-white ml-1" />
        </div>
      </button>
      <p class="mt-8 text-slate-600 text-xs tracking-wider uppercase">Toca para empezar</p>
    </div>

    <!-- Ejercicio -->
    <div id="exercise-screen" class="hidden flex-col items-center justify-center w-full max-w-sm mx-auto">
      <p id="technique-name" class="text-sm text-slate-500 uppercase tracking-widest mb-6">4-7-8</p>

      <!-- Circulo de progreso -->
      <div class="relative w-64 h-64 md:w-72 md:h-72 mb-8">
        <svg class="w-full h-full -rotate-90" viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="90" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="6" />
          <circle 
            id="progress-ring" 
            cx="100" cy="100" r="90" 
            fill="none" 
            stroke="#2dd4bf" 
            stroke-width="6"
            stroke-linecap="round"
            stroke-dasharray="565.48"
            stroke-dashoffset="565.48"
          />
        </svg>
        
        <!-- Orbe que respira -->
        <div class="absolute inset-6 rounded-full bg-white/5 border border-white/10 flex items-center justify-center overflow-hidden">
          <div id="breath-orb" class="w-24 h-24 md:w-28 md:h-28 rounded-full flex items-center justify-center" style="transition: transform 4s ease-in-out, background 0.8s ease">
            <span id="seconds-display" class="text-4xl md:text-5xl font-bold text-white">4</span>
          </div>
        </div>
      </div>

      <!-- Fase -->
      <p id="phase-text" class="text-2xl md:text-3xl font-semibold text-white mb-2 h-10">Inhala</p>
      <p id="phase-subtext" class="text-sm text-slate-500 mb-6">por la nariz</p>

      <!-- Timer -->
      <div class="flex items-center gap-2 text-slate-500 mb-8">
        <img src="/icons/clock.svg" alt="" class="w-4 h-4" />
        <span id="total-timer" class="text-sm font-mono">3:00</span>
      </div>

      <!-- Controles -->
      <div class="flex gap-3">
        <button id="pause-btn" class="w-14 h-14 rounded-full bg-slate-800 hover:bg-slate-700 flex items-center justify-center transition-colors border border-slate-700">
          <img src="/icons/pause.svg" alt="" class="w-5 h-5 text-white" />
        </button>
        <button id="stop-btn" class="w-14 h-14 rounded-full bg-slate-800 hover:bg-slate-700 flex items-center justify-center transition-colors border border-slate-700">
          <img src="/icons/x.svg" alt="" class="w-5 h-5 text-white" />
        </button>
      </div>
    </div>
  </main>

  <script>
    // Configuracion 4-7-8
    const INHALE = 4;
    const HOLD = 7;
    const EXHALE = 8;
    const HOLD_EMPTY = 0;
    const CYCLE = INHALE + HOLD + EXHALE + HOLD_EMPTY; // 19 segundos
    const TOTAL = 180;
    const CIRC = 2 * Math.PI * 90;

    // Colores calmantes por fase
    const COLORS = ['#2dd4bf', '#a5b4fc', '#67e8f9']; // teal, indigo, cyan
    const PHASE_NAMES = ['Inhala', 'Sostén', 'Exhala'];
    const PHASE_SUBS = ['por la nariz', 'mantén', 'lentamente'];
    const PHASE_DURS = [INHALE, HOLD, EXHALE];

    // DOM
    const home = document.getElementById('home-screen');
    const exercise = document.getElementById('exercise-screen');
    const ring = document.getElementById('progress-ring');
    const orb = document.getElementById('breath-orb');
    const secs = document.getElementById('seconds-display');
    const phase = document.getElementById('phase-text');
    const sub = document.getElementById('phase-subtext');
    const timer = document.getElementById('total-timer');

    let playing = false, paused = false;
    let totalLeft = TOTAL;
    let cycleProgress = 0; // 0 a 1
    let currentPhaseIdx = 0;
    let phaseTimeLeft = PHASE_DURS[0];
    let mainInterval = null;

    function fmt(s) { return Math.floor(s/60) + ':' + (s%60).toString().padStart(2,'0'); }

    function updateRing(progress, color) {
      ring.style.strokeDashoffset = CIRC * (1 - progress);
      ring.style.stroke = color;
    }

    function updateOrb(scale, color) {
      orb.style.transform = `scale(${scale})`;
      orb.style.background = color;
    }

    function setPhaseUI(idx) {
      currentPhaseIdx = idx;
      phaseTimeLeft = PHASE_DURS[idx];
      phase.textContent = PHASE_NAMES[idx];
      sub.textContent = PHASE_SUBS[idx];
      secs.textContent = phaseTimeLeft;
      
      const color = COLORS[idx];
      const scale = idx === 0 ? 1.35 : 1; // inhala expands, others stay
      updateOrb(scale, idx === 0 ? `radial-gradient(circle, ${color}66, ${color}33)` : `radial-gradient(circle, ${color}44, ${color}22)`);
    }

    function tick() {
      if (!playing || paused) return;
      
      totalLeft--;
      timer.textContent = fmt(totalLeft);
      
      if (totalLeft <= 0) { complete(); return; }
      
      // Avanzar progreso de ciclo
      cycleProgress += 1 / CYCLE;
      
      // Cambiar de fase si es necesario
      phaseTimeLeft--;
      if (phaseTimeLeft <= 0) {
        currentPhaseIdx++;
        if (currentPhaseIdx >= PHASE_DURS.length) {
          currentPhaseIdx = 0; // Volver al inicio del ciclo
          cycleProgress = 0; // Reset barra
        }
        setPhaseUI(currentPhaseIdx);
      }
      
      secs.textContent = phaseTimeLeft;
      updateRing(cycleProgress, COLORS[currentPhaseIdx]);
    }

    function start() {
      home.classList.add('hidden');
      exercise.classList.remove('hidden');
      exercise.classList.add('flex');
      
      playing = true;
      paused = false;
      totalLeft = TOTAL;
      cycleProgress = 0;
      currentPhaseIdx = 0;
      phaseTimeLeft = PHASE_DURS[0];
      
      timer.textContent = fmt(totalLeft);
      setPhaseUI(0);
      updateRing(0, COLORS[0]);
      
      mainInterval = setInterval(tick, 1000);
    }

    function pause() {
      if (paused) {
        paused = false;
        document.getElementById('pause-btn').querySelector('img').src = '/icons/pause.svg';
        mainInterval = setInterval(tick, 1000);
      } else {
        paused = true;
        clearInterval(mainInterval);
        document.getElementById('pause-btn').querySelector('img').src = '/icons/play.svg';
        phase.textContent = 'Pausado';
      }
    }

    function stop() {
      playing = false;
      paused = false;
      clearInterval(mainInterval);
      
      orb.style.transform = 'scale(1)';
      orb.style.background = 'radial-gradient(circle, #2dd4bf44, #2dd4bf22)';
      updateRing(0, '#2dd4bf');
      secs.textContent = INHALE;
      phase.textContent = 'Inhala';
      sub.textContent = 'por la nariz';
      timer.textContent = fmt(TOTAL);
      
      exercise.classList.add('hidden');
      exercise.classList.remove('flex');
      home.classList.remove('hidden');
      home.classList.add('flex');
    }

    function complete() {
      playing = false;
      clearInterval(mainInterval);
      
      phase.textContent = 'Completado';
      sub.textContent = 'bien hecho';
      secs.textContent = '';
      orb.style.transform = 'scale(1)';
      orb.style.background = 'radial-gradient(circle, #86efac66, #86efac33)';
      updateRing(1, '#86efac');
      
      setTimeout(stop, 3000);
    }

    document.getElementById('start-btn').addEventListener('click', start);
    document.getElementById('pause-btn').addEventListener('click', pause);
    document.getElementById('stop-btn').addEventListener('click', stop);
  </script>
</BaseLayout>
