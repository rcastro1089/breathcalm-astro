---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreathingExercise from '../components/BreathingExercise.astro';
import { HOME, REVIEWER, SITE } from '../data/site';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calma en 3 Minutos',
  alternateName: 'Ejercicios de respiración para la ansiedad',
  description:
    'Herramienta web gratuita de respiración guiada para calmar un ataque de ansiedad o de pánico en 3 minutos. Sin registro, sin descarga.',
  url: 'https://calmaen3minutos.com/',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requiere JavaScript. Funciona en Chrome, Firefox, Safari y Edge.',
  inLanguage: 'es',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Person', name: 'Ricardo Castro' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Calma un Ataque de Ansiedad en 3 Minutos | Respiración Guiada"
  description="Respiración guiada para calmar un ataque de ansiedad o de pánico en 3 minutos. Sigue el círculo, sin contar. Sin descargar, sin registro, gratis."
  path="/"
  header={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero / herramienta -->
  <main class="min-h-[100svh] bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex flex-col items-center justify-center px-4 py-16">
    <BreathingExercise heading={HOME.hero.h1} sub={HOME.hero.sub} micro={HOME.hero.micro} />
    <a href="#saber-mas" class="mt-14 text-slate-500 text-xs hover:text-slate-300 transition-colors">Saber más ↓</a>
  </main>

  <div id="saber-mas" class="bg-slate-900">
    <div class="max-w-3xl mx-auto px-4 py-16 space-y-16">

      <!-- Por qué funciona -->
      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">{HOME.why.h2}</h2>
        {HOME.why.body.map((p) => <p class="text-slate-300 leading-relaxed mb-4">{p}</p>)}
      </section>

      <!-- Técnicas -->
      <section id="tecnicas">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">{HOME.techniquesIntro.h2}</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {HOME.techniquesIntro.items.map((t) => (
            <li>
              <a
                href={`/tecnica/${t.slug}/`}
                class="block h-full rounded-2xl border border-slate-700 bg-slate-800/40 p-5 hover:border-teal-400/60 hover:bg-slate-800/70 transition-colors"
              >
                <h3 class="font-bold text-white mb-1">{t.name}</h3>
                <p class="text-sm text-slate-300">{t.forWhat}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Síntomas -->
      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">{HOME.symptoms.h2}</h2>
        <ul class="grid gap-x-6 gap-y-2 sm:grid-cols-2 text-slate-300 mb-6">
          {HOME.symptoms.list.map((s) => (
            <li class="flex gap-2"><span class="text-teal-400" aria-hidden="true">·</span><span>{s}</span></li>
          ))}
        </ul>
        <p class="text-slate-300 leading-relaxed">{HOME.symptoms.reassurance}</p>
      </section>

      <!-- Sueño / estrés -->
      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">{HOME.sleepStress.h2}</h2>
        <p class="text-slate-300 leading-relaxed mb-4">{HOME.sleepStress.body}</p>
        <p class="flex flex-wrap gap-4 text-teal-300">
          <a class="hover:text-teal-200" href="/tecnica/respiracion-4-7-8/">Respiración para dormir →</a>
          <a class="hover:text-teal-200" href="/tecnica/respiracion-diafragmatica/">Respiración para el estrés →</a>
        </p>
      </section>

      <!-- Sin fricción -->
      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">{HOME.noFriction.h2}</h2>
        <p class="text-slate-300 leading-relaxed">{HOME.noFriction.body}</p>
      </section>

      <!-- Revisión médica -->
      <section class="rounded-2xl border border-slate-700 bg-slate-800/40 p-6 flex flex-col sm:flex-row gap-5 items-start">
        <img src={REVIEWER.photo} alt={`Foto de ${REVIEWER.name}`} width="72" height="72" class="w-[72px] h-[72px] rounded-full object-cover shrink-0" />
        <div>
          <p class="text-slate-200">
            Contenido revisado por la <strong class="text-white">{REVIEWER.name}</strong>, {REVIEWER.title}.
            Última revisión: {new Date(REVIEWER.lastReviewed).toLocaleDateString('es-ES', { year: 'numeric', month: 'long' })}.
          </p>
          <p class="text-sm text-slate-400 mt-2">
            Los ejercicios de respiración ayudan a muchas personas a recuperar el control en el momento.
            No sustituyen el diagnóstico ni el tratamiento de un profesional de salud mental.
          </p>
          <a href="/nosotros/#revision" class="text-sm text-teal-300 hover:text-teal-200 mt-2 inline-block">Sobre quién está detrás →</a>
        </div>
      </section>

      <!-- FAQ -->
      <section>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Preguntas frecuentes</h2>
        <div class="space-y-5">
          {HOME.faq.map((f) => (
            <div>
              <h3 class="font-semibold text-white mb-1">{f.q}</h3>
              <p class="text-slate-300 leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>

  <!-- Modal de captura de email (post-ejercicio) -->
  <div id="email-modal" hidden class="fixed inset-0 z-[60] bg-black/70 flex items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl bg-slate-800 border border-slate-700 p-6 text-center">
      <p class="text-xl font-bold text-white mb-1">Lo lograste</p>
      <p class="text-sm text-slate-300 mb-5">Has respirado unos minutos. Si el pulso sigue alto, repítelo: no hay límite.</p>
      <button id="modal-repeat" type="button" class="w-full py-3 rounded-xl bg-teal-500 hover:bg-teal-600 text-white font-bold transition-colors mb-5">Repetir el ejercicio</button>

      <div class="border-t border-slate-700 pt-5 text-left">
        <p class="text-sm text-slate-300 mb-3">¿Quieres tenerlo preparado para la próxima vez? Te enviamos la guía gratuita <strong class="text-white">«5 pasos para detener el pánico»</strong>.</p>
        <form id="email-form" class="flex flex-col gap-2">
          <input id="email-input" type="email" required placeholder="nombre@correo.com"
            class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-600 text-white placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-400" />
          <button type="submit" class="py-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-white font-medium transition-colors">Enviármela</button>
        </form>
        <p id="email-msg" class="text-xs text-slate-400 mt-2">Opcional. Sin spam. Puedes darte de baja cuando quieras.</p>
        <button id="modal-close" type="button" class="text-xs text-slate-500 hover:text-slate-300 mt-3">Ahora no</button>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('email-modal');
    const openModal = () => { if (modal) modal.hidden = false; };
    const closeModal = () => { if (modal) modal.hidden = true; };

    document.addEventListener('bc:completed', () => setTimeout(openModal, 3500));
    document.getElementById('modal-close')?.addEventListener('click', closeModal);
    document.getElementById('modal-repeat')?.addEventListener('click', () => {
      closeModal();
      document.getElementById('start-btn')?.dispatchEvent(new Event('click'));
    });

    const form = document.getElementById('email-form') as HTMLFormElement | null;
    const input = document.getElementById('email-input') as HTMLInputElement | null;
    const msg = document.getElementById('email-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!input || !msg) return;
      msg.textContent = 'Enviando…';
      try {
        const r = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value }),
        });
        msg.textContent = r.ok
          ? 'Revisa tu correo (mira también en spam). La guía va de camino.'
          : 'No se pudo enviar ahora. Escríbenos y te la mandamos.';
      } catch {
        msg.textContent = 'No se pudo enviar ahora. Escríbenos y te la mandamos.';
      }
    });
  </script>
</BaseLayout>
