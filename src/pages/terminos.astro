---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from '../components/ui/LanguageSwitcher.tsx';

const seo = {
  title: "Términos de Servicio | Calma en 3 Minutos",
  description: "Términos y condiciones de uso de Calma en 3 Minutos. Lee los términos antes de utilizar nuestro servicio.",
  canonical: "https://calmaen3minutos.com/terminos/",
};
---

<BaseLayout 
  title={seo.title} 
  description={seo.description}
  canonical={seo.canonical}
>
  <main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <header class="fixed top-0 left-0 right-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-400 to-cyan-500 flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h1 class="text-xl font-bold text-white">Calma en 3 Minutos</h1>
        </a>
        <LanguageSwitcher client:load />
      </div>
    </header>

    <section class="pt-24 pb-16 px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-white mb-8">Términos de Servicio</h2>
        
        <div class="prose prose-invert max-w-none">
          <h3 class="text-xl font-bold text-white mt-8 mb-4">1. Aceptación</h3>
          <p class="text-slate-300 mb-4">
            Al acceder y utilizar Calma en 3 Minutos, aceptas estos términos de servicio.
          </p>

          <h3 class="text-xl font-bold text-white mt-8 mb-4">2. Uso del Servicio</h3>
          <p class="text-slate-300 mb-4">
            Calma en 3 Minutos proporciona ejercicios de respiración para fines informativos y de bienestar. No sustituye consejo médico profesional.
          </p>

          <h3 class="text-xl font-bold text-white mt-8 mb-4">3. Limitación de Responsabilidad</h3>
          <p class="text-slate-300 mb-4">
            El uso de esta aplicación es bajo tu propio riesgo. Consulta a un profesional de la salud antes de comenzar cualquier programa de ejercicio.
          </p>

          <h3 class="text-xl font-bold text-white mt-8 mb-4">4. Propiedad Intelectual</h3>
          <p class="text-slate-300 mb-4">
            El contenido y diseño de Calma en 3 Minutos están protegidos por derechos de autor.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
