---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d: Date) => d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog | Calma en 3 Minutos"
  description="Guías prácticas sobre respiración, ansiedad y ataques de pánico: qué hacer en una crisis, cómo dormir mejor y por qué la respiración funciona. Revisadas médicamente."
  path="/blog/"
  noindex={posts.length === 0}
>
  <main class="bg-slate-900">
    <div class="max-w-2xl mx-auto px-4 py-12">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Blog</h1>
      <p class="text-slate-300 mb-10">Guías sobre respiración, ansiedad y crisis de pánico. Cada artículo lo revisa una médica.</p>

      {posts.length === 0 ? (
        <p class="text-slate-400">Todavía no hay artículos publicados.</p>
      ) : (
        <ul class="space-y-6">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`} class="block rounded-2xl border border-slate-700 bg-slate-800/40 p-5 hover:border-teal-400/60 transition-colors">
                <h2 class="text-lg font-bold text-white mb-1">{p.data.title}</h2>
                <p class="text-sm text-slate-300 mb-2">{p.data.description}</p>
                <p class="text-xs text-slate-500">{fmt(p.data.pubDate)}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</BaseLayout>
