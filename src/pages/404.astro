---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV_TECNICAS } from '../data/site';

const tecnicas = NAV_TECNICAS.map((t) => ({ href: `/tecnica/${t.slug}/`, label: t.label }));
---

<BaseLayout
  title="Página no encontrada (404) | Calma en 3 Minutos"
  description="La página que buscas no existe o se ha movido. Vuelve al inicio para empezar un ejercicio de respiración guiada, gratis y sin registro."
  path="/404/"
  noindex={true}
>
  <main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 flex flex-col items-center justify-center px-4 text-center">
    <p class="text-teal-400 text-sm uppercase tracking-widest mb-3">Error 404</p>
    <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Esta página no existe</h1>
    <p class="text-slate-300 max-w-md mb-8">
      El enlace es incorrecto o el contenido se ha movido. Puedes volver al inicio y
      empezar un ejercicio de respiración ahora mismo.
    </p>
    <a
      href="/"
      class="inline-block px-8 py-4 bg-teal-500 hover:bg-teal-600 text-white font-bold rounded-xl transition-colors"
    >
      Ir al inicio
    </a>

    <nav class="mt-12" aria-label="Técnicas de respiración">
      <p class="text-slate-400 text-sm mb-3">O ve directo a una técnica:</p>
      <ul class="flex flex-wrap justify-center gap-3">
        {tecnicas.map((t) => (
          <li>
            <a href={t.href} class="text-teal-300 hover:text-teal-200 underline underline-offset-4">
              {t.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>
</BaseLayout>
