---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TECHNIQUE_PAGES } from '../../data/techniquePages';
import { BREATHING_TECHNIQUES } from '../../data/constants';
import { REVIEWER, NAV_TECNICAS, SITE } from '../../data/site';

export function getStaticPaths() {
  return Object.values(TECHNIQUE_PAGES).map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const cfg = BREATHING_TECHNIQUES.find((t) => t.id === page.techniqueId)!;
const url = `${SITE.domain}/tecnica/${page.slug}/`;
const related = NAV_TECNICAS.filter((t) => t.slug !== page.slug);

const pattern = [
  ['Inhalar', cfg.inhale],
  ['Mantener', cfg.hold],
  ['Exhalar', cfg.exhale],
  ['Pausa sin aire', cfg.holdEmpty ?? 0],
].filter(([, v]) => (v as number) > 0);

const reviewedISO = page.lastReviewedDate;
const reviewedHuman = new Date(reviewedISO).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

const personSchema = {
  '@type': 'Person',
  name: REVIEWER.name,
  jobTitle: 'Doctora en Medicina',
  url: REVIEWER.linkedin,
  identifier: REVIEWER.registration,
  knowsAbout: ['Medicina', 'Neonatología', 'Atención temprana', 'Educación para la salud', 'Técnicas de respiración'],
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: page.seo.h1,
    description: page.seo.description,
    url,
    inLanguage: 'es',
    lastReviewed: reviewedISO,
    reviewedBy: personSchema,
    audience: { '@type': 'PeopleAudience', name: 'Personas con ansiedad o estrés' },
    citation: page.citations.map((c) => c.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: page.seo.h1,
    description: page.content.howItWorks,
    totalTime: `PT${cfg.totalTime}M`,
    step: page.content.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      text: s,
      url: `${url}#paso-${i + 1}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Técnicas', item: `${SITE.domain}/#tecnicas` },
      { '@type': 'ListItem', position: 3, name: page.seo.h1, item: url },
    ],
  },
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} path={`/tecnica/${page.slug}/`} ogType="article">
  {schema.map((s) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(s)} />)}

  <main class="bg-slate-900">
    <article class="max-w-2xl mx-auto px-4 py-12">
      <nav class="text-xs text-slate-500 mb-6" aria-label="Migas de pan">
        <a href="/" class="hover:text-slate-300">Inicio</a> ·
        <a href="/#tecnicas" class="hover:text-slate-300">Técnicas</a>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-5">{page.seo.h1}</h1>
      <p class="text-lg text-slate-300 leading-relaxed mb-6">{page.content.intro}</p>

      <!-- Byline E-E-A-T -->
      <div class="flex items-center gap-3 rounded-xl border border-slate-700 bg-slate-800/40 p-3 mb-8">
        <img src={REVIEWER.photo} alt={`Foto de ${REVIEWER.name}`} width="40" height="40" class="w-10 h-10 rounded-full object-cover shrink-0" />
        <p class="text-xs text-slate-400">
          Revisado por <a href="/nosotros/#revision" class="text-slate-200 font-medium hover:text-white">{REVIEWER.name}</a>,
          {' '}Doctora en Medicina · Última revisión: {reviewedHuman} · {page.citations.length} fuentes
        </p>
      </div>

      <!-- CTA a practicar -->
      <div class="text-center rounded-2xl bg-slate-800/50 border border-slate-700 p-6 mb-10">
        <p class="text-4xl font-bold text-teal-400 mb-2 font-mono">{pattern.map(([, v]) => v).join('-')}</p>
        <p class="text-sm text-slate-400 mb-4">{pattern.map(([k]) => k).join(' · ')} (segundos)</p>
        <a href={`/?tecnica=${page.slug}&start=1`} class="inline-block px-8 py-4 bg-teal-500 hover:bg-teal-600 text-white font-bold rounded-xl transition-colors">
          {page.cta.text}
        </a>
        <p class="mt-2 text-xs text-slate-500">{page.cta.subtext}</p>
      </div>

      <h2 class="text-xl font-bold text-white mt-10 mb-3">¿Cómo funciona?</h2>
      <p class="text-slate-300 leading-relaxed">{page.content.howItWorks}</p>

      <h2 class="text-xl font-bold text-white mt-10 mb-3">Beneficios</h2>
      <ul class="space-y-2">
        {page.content.benefits.map((b) => (
          <li class="flex gap-2 text-slate-300"><span class="text-teal-400 shrink-0" aria-hidden="true">·</span><span>{b}</span></li>
        ))}
      </ul>

      <h2 class="text-xl font-bold text-white mt-10 mb-3">Cuándo usarla</h2>
      <p class="text-slate-300 leading-relaxed">{page.content.whenToUse}</p>

      <h2 class="text-xl font-bold text-white mt-10 mb-4">Pasos</h2>
      <ol class="space-y-3">
        {page.content.steps.map((s, i) => (
          <li id={`paso-${i + 1}`} class="flex gap-3">
            <span class="shrink-0 w-7 h-7 rounded-full bg-teal-500 text-white text-sm font-bold flex items-center justify-center">{i + 1}</span>
            <span class="text-slate-300 pt-0.5">{s}</span>
          </li>
        ))}
      </ol>

      <h2 class="text-xl font-bold text-white mt-10 mb-3">Seguridad</h2>
      <p class="text-slate-300 leading-relaxed">{page.content.safety}</p>

      <h2 class="text-xl font-bold text-white mt-10 mb-4">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {page.faq.map((f) => (
          <div>
            <h3 class="font-semibold text-white mb-1">{f.q}</h3>
            <p class="text-slate-300 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>

      <h2 class="text-xl font-bold text-white mt-10 mb-3">Fuentes</h2>
      <ul class="space-y-2 text-sm">
        {page.citations.map((c) => (
          <li>
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-teal-300 hover:text-teal-200 break-words">{c.text}</a>
          </li>
        ))}
      </ul>

      <div class="mt-10 rounded-xl border border-slate-700 bg-slate-800/40 p-4">
        <p class="text-sm text-slate-300">Esto ayuda en el momento. Si los ataques se repiten, habla con un profesional. En el pie de página tienes líneas de ayuda por país.</p>
      </div>

      <h2 class="text-xl font-bold text-white mt-10 mb-4">Otras técnicas</h2>
      <ul class="grid gap-2 sm:grid-cols-2">
        {related.map((t) => (
          <li><a href={`/tecnica/${t.slug}/`} class="block rounded-lg border border-slate-700 bg-slate-800/40 px-4 py-3 text-slate-300 hover:border-teal-400/60 hover:text-white transition-colors">{t.label}</a></li>
        ))}
      </ul>
    </article>
  </main>
</BaseLayout>
