---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Nasal Alternante: Equilibrio Mental";
const description = "Técnica yóguica que equilibra hemisferios cerebrales.";
const pattern = "4-2-4";
const canonical = "https://calmaen3minutos.com/tecnica/nasal-alternante/";
---
<BaseLayout title={title + " | Calma en 3 Minutos"} description={description} canonical={canonical}>
  <main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
    <header class="fixed top-0 left-0 right-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50">
      <div class="max-w-4xl mx-auto px-4 py-4"><a href="/" class="text-teal-400 hover:text-teal-300">← Volver</a></div>
    </header>
    <section class="pt-24 pb-16 px-4">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{title}</h1>
        <p class="text-xl text-slate-400 mb-8">{description}</p>
        <div class="bg-slate-800/50 rounded-2xl p-8 mb-8 text-center">
          <div class="text-6xl font-bold text-teal-400 mb-4">{pattern}</div>
          <p class="text-slate-400">Segundos: Inhalar - Sostener - Exhalar</p>
          <a href="/" class="mt-6 inline-block px-8 py-4 bg-teal-500 hover:bg-teal-600 text-white font-bold rounded-xl transition-colors">Empezar Ejercicio</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
