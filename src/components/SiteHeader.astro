---
import { SITE } from '../data/site';
---
<header class="sticky top-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-700/50">
  <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
      <span class="w-9 h-9 rounded-lg bg-gradient-to-br from-teal-400 to-cyan-500 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h9a3 3 0 1 0-3-3M4 16h13a3 3 0 1 1-3 3M4 12h16" />
        </svg>
      </span>
      <span class="font-bold text-white tracking-tight">{SITE.name}</span>
    </a>
    <nav class="flex items-center gap-5 text-sm text-slate-300">
      <a href="/#tecnicas" class="hover:text-white transition-colors">Técnicas</a>
      <a href="/nosotros/" class="hover:text-white transition-colors">Nosotros</a>
    </nav>
  </div>
</header>
