---
// Banner mínimo de consentimiento de cookies.
---
<div
  id="cookie-banner"
  style="display:none"
  class="fixed bottom-0 inset-x-0 z-50 bg-slate-950/95 border-t border-slate-800 px-4 py-3 text-sm text-slate-300 flex flex-wrap items-center justify-center gap-3"
>
  <span>Usamos cookies de analítica anónima. Puedes aceptarlas o rechazarlas.</span>
  <span class="flex gap-2">
    <button id="cookie-accept" type="button" class="px-3 py-1.5 rounded-lg bg-teal-500 hover:bg-teal-600 text-white font-medium transition-colors">Aceptar</button>
    <button id="cookie-reject" type="button" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white transition-colors border border-slate-700">Rechazar</button>
  </span>
  <a href="/privacidad/" class="text-teal-300 hover:text-teal-200 underline underline-offset-2">Más info</a>
</div>
<script is:inline>
  (function () {
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;
    var show = function () { banner.style.display = 'flex'; };
    var hide = function () { banner.style.display = 'none'; };
    if (!localStorage.getItem('cookie-consent')) show();
    function set(v) {
      localStorage.setItem('cookie-consent', v);
      hide();
      if (v === 'granted' && window.gtag) {
        window.gtag('consent', 'update', { analytics_storage: 'granted' });
      }
    }
    document.getElementById('cookie-accept')?.addEventListener('click', function () { set('granted'); });
    document.getElementById('cookie-reject')?.addEventListener('click', function () { set('denied'); });
  })();
</script>
